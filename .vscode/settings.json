{
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "wrangler.jsonc": ".env*, worker-configuration.d.ts",
        "package.json": "*.lock, .editorconfig, biome.json, tsconfig.json"
    },
    "files.exclude": {
